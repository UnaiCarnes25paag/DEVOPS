FROM ubuntu:latest

WORKDIR /app
# Update package lists and install Python and dependencies
RUN apt-get update && \
    apt-get install -y python3 python3-pip python3-flask python3-requests gunicorn
# Copy the application
COPY pythonejemplo.py .
# Expose the port the app will run on
EXPOSE 5000
# Command to run the application
CMD ["python3", "pythonejemplo.py"]
